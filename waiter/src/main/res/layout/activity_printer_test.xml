<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ТЕСТОВАЯ ПЕЧАТЬ"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FF5722"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tv_test_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Загрузка..."
            android:textSize="14sp"
            android:textColor="#333333"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/btn_system_print"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Системная печать (PDF)"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_usb_print"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Прямая USB печать (Raw)"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_escpos_print"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ESC/POS печать (Термопринтер)"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\nПримечание:\n• Системная печать — использует Android Print Framework, совместима с любыми установленными драйверами.\n• Прямая USB — отправляет raw текст на USB-принтер класса 7.\n• ESC/POS — для чековых принтеров (XPrinter, Epson и др.)."
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
