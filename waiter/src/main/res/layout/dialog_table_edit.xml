<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/et_table_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/table_label"
        android:inputType="textCapSentences" />

    <EditText
        android:id="@+id/et_table_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/table_number"
        android:inputType="number" />

    <EditText
        android:id="@+id/et_table_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/table_description" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/table_status_field"
        android:textColor="@color/textSecondary"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/spinner_table_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />
</LinearLayout>
