<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <style name="PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary_selector</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/textOnDark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
    </style>

    <style name="SecondaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_secondary_selector</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
    </style>

    <style name="SuccessButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_success_selector</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/textOnDark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
    </style>

    <style name="NeutralButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_neutral_selector</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/textOnDark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
    </style>

    <style name="TileNumber">
        <item name="android:fontFamily">@font/instrument_serif_regular</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <style name="MainScreenTitle">
        <item name="android:fontFamily">@font/instrument_serif_regular</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <style name="MainScreenSubtitle">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="MainScreenButton" parent="SecondaryButton">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="PageTitle">
        <item name="android:fontFamily">@font/instrument_serif_regular</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <style name="TotalAmount">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <style name="BodyText">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>
</resources>
