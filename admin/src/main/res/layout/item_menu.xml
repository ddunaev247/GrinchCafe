<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingTop="8dp"
    android:paddingRight="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_menu_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/textPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_menu_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_edit_menu"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_info_button"
        android:clickable="true"
        android:contentDescription="@string/edit"
        android:focusable="true"
        android:gravity="center"
        android:text="✎"
        android:textColor="@color/infoButtonText"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btn_delete_menu"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="6dp"
        android:background="@drawable/bg_info_button"
        android:clickable="true"
        android:contentDescription="@string/delete"
        android:focusable="true"
        android:gravity="center"
        android:text="✕"
        android:textColor="@color/buttonDanger"
        android:textSize="16sp" />
</LinearLayout>
